# ── Dependencies ────────────────────────────────────────────
node_modules/
.pnp.*
.yarn/

# ── Build output ────────────────────────────────────────────
dist/
dist-ssr/
build/
coverage/
*.tsbuildinfo

# ── Environment files (never commit real values) ────────────
.env
.env.*
!.env.example
!.env.development
# Generated by sequelize-cli in older setups; config now lives in config.cjs (env-driven, no secrets)
*.local

# ── Local backups / migration safety copies ─────────────────
.backup/
*.bundle

# ── Database dumps (contain personal data — see database/README.md) ──
database/dump/*.sql
database/dump/*.dump
!database/dump/.gitkeep

# ── Local file uploads (STORAGE_DRIVER=local) ───────────────
backend/uploads/

# ── Logs ────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Editors / OS ────────────────────────────────────────────
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*.suo
.DS_Store
Thumbs.db

# ── Tooling ─────────────────────────────────────────────────
.claude/settings.local.json
