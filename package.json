{
  "name": "wanderluxe",
  "private": true,
  "description": "WanderLuxe travel agency \u2014 React + Vite frontend, Express API, PostgreSQL",
  "workspaces": [
    "backend",
    "frontend",
    "e2e"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "setup": "node scripts/setup-env.mjs",
    "dev": "concurrently -k -n api,web -c cyan,magenta \"npm:dev -w backend\" \"npm:dev -w frontend\"",
    "dev:backend": "npm run dev -w backend",
    "dev:frontend": "npm run dev -w frontend",
    "build": "npm run build -w backend && npm run build -w frontend",
    "start": "npm run start -w backend",
    "lint": "npm run lint -w backend && npm run lint -w frontend",
    "typecheck": "npm run typecheck -w backend && npm run typecheck -w frontend && npm run typecheck -w e2e",
    "test": "npm run test -w backend && npm run test -w frontend",
    "test:e2e": "npm run test -w e2e",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:import": "database/scripts/db.sh import",
    "db:import:test": "database/scripts/db.sh import --test --file database/schema/baseline.sql",
    "db:reset": "database/scripts/db.sh reset",
    "db:psql": "database/scripts/db.sh psql",
    "db:migrate": "npm run db:migrate -w backend",
    "db:migrate:test": "npm run db:migrate:test -w backend",
    "db:dev-users": "npm run db:dev-users -w backend",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "concurrently": "^9.2.5"
  },
  "allowScripts": {
    "esbuild": true,
    "sharp": true
  },
  "overrides": {
    "react-markdown-editor-lite": {
      "nanoid": "^5.1.16"
    },
    "sequelize": {
      "uuid": "^11.1.1"
    },
    "js-beautify": {
      "glob": "^14.0.6"
    },
    "editorconfig": {
      "minimatch": "^11.0.9"
    },
    "postcss-selector-parser": "^6.1.6"
  }
}
