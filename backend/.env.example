# ─────────────────────────────────────────────────────────────────────────────
# WanderLuxe API — environment variables
# Copy to backend/.env (npm run setup does this for you with random secrets).
# Never commit real values. Never put any of these in frontend VITE_* variables.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=3000
# Public URL of the frontend (used for links in e-mails)
APP_URL=http://localhost:5173
# Comma-separated list of browser origins allowed to call the API
CORS_ORIGIN=http://localhost:5173
# Number of proxies in front of the API, for the client IP used by rate limiting
# (2 on Vercel -> Render: Vercel's /api rewrite plus Render's load balancer)
TRUST_PROXY=
# debug | info | warn | error | silent
LOG_LEVEL=

# ── PostgreSQL ───────────────────────────────────────────────────────────────
# Either DATABASE_URL=postgres://user:pass@host:5432/db  or the individual values.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=wanderluxe
# Least-privilege role the app runs as (SELECT/INSERT/UPDATE/DELETE only)
DB_USER=wanderluxe_app
DB_PASSWORD=
# Owner role used by sequelize-cli migrations (needs DDL rights)
DB_MIGRATION_USER=wanderluxe_owner
DB_MIGRATION_PASSWORD=
# Remote databases (Supabase): DB_SSL=true and the provider's CA certificate (PEM; "\n" escapes ok)
DB_SSL=false
DB_SSL_CA=
# Only if you cannot supply DB_SSL_CA: encrypt without verifying the server (not recommended)
DB_SSL_REJECT_UNAUTHORIZED=true
DB_POOL_MAX=10

# ── Authentication ───────────────────────────────────────────────────────────
# Signs the short-lived access tokens. >= 32 chars in production:  openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
# Session lifetime (httpOnly cookie, stored hashed in refresh_tokens); extended on every refresh
JWT_REFRESH_EXPIRES_IN=7d
# Secure flag on the session cookie. Empty = on in production, off in development (http://localhost)
COOKIE_SECURE=
BCRYPT_ROUNDS=12

# ── Rate limiting (per IP, per window) ───────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_FORMS_MAX=10

# ── E-mail ───────────────────────────────────────────────────────────────────
# Local: Mailpit from docker compose (UI at http://localhost:8025).
# Leave SMTP_HOST empty to only log e-mails to the console.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="WanderLuxe Travel <no-reply@wanderluxe.local>"
# Inbox that receives contact-form messages
CONTACT_RECIPIENT_EMAIL=admin@wanderluxe.local

# ── Image storage ────────────────────────────────────────────────────────────
# local    → files in backend/uploads, served at /uploads (development default)
# supabase → Supabase Storage buckets (production default)
STORAGE_DRIVER=local
# Base URL images are served from (local: http://localhost:3000/uploads,
# supabase: https://<project>.supabase.co/storage/v1/object/public)
STORAGE_PUBLIC_URL=http://localhost:3000/uploads
# local driver only: public, read-only base URL used for images that are not on
# disk (e.g. those referenced by the imported production dump). Optional.
STORAGE_FALLBACK_URL=
# Supabase (only needed when STORAGE_DRIVER=supabase)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET_TOURS=tours
SUPABASE_BUCKET_DESTINATIONS=destinations
SUPABASE_BUCKET_BLOGS=blogs

# ── Local development accounts (npm run db:dev-users) ────────────────────────
# Created only against a local database; never used in production.
DEV_ADMIN_PASSWORD=DevAdmin#2026
DEV_CUSTOMER_PASSWORD=DevCustomer#2026
