# Frontend environment — everything prefixed VITE_ is bundled into the
# JavaScript sent to browsers, so ONLY put public values here.
# Never add database passwords, JWT secrets, SMTP or Supabase service keys.

# Base URL of the API.
#   development: /api  (Vite proxies it to API_PROXY_TARGET below)
#   production:  https://<your-api-host>/api
VITE_API_URL=/api

# Dev-server only (not exposed to the browser): where Vite forwards /api and /uploads.
API_PROXY_TARGET=http://localhost:3000

# Build time only (not bundled): public site address for sitemap.xml and robots.txt.
# SITE_URL=https://wanderluxe.vercel.app
